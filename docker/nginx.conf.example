# nginx in front of FinTrack at https://miniserver.local/finances
#
# proxy_pass has no URI part, so the full /finances/... path reaches FinTrack
# (FINTRACK_BASE_PATH=/finances).

server {
    listen 443 ssl;
    server_name miniserver.local;

    ssl_certificate     /etc/nginx/certs/miniserver.local.crt;
    ssl_certificate_key /etc/nginx/certs/miniserver.local.key;

    location /finances {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        # Bank CSVs and database uploads; keep in step with FINTRACK_MAX_UPLOAD_MB.
        client_max_body_size 50m;
    }
}
